# Copy to .env and fill in. Never commit .env.

# Storage
DATABASE_URL=postgresql+psycopg://vlabel:vlabel@localhost:5432/vlabel
BLOB_BACKEND=local            # local | minio
BLOB_LOCAL_DIR=./blobs
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minio
# MINIO_SECRET_KEY=minio123

# Active model profile (see config/profiles/*.yaml)
MODEL_PROFILE=regular

# Proprietary providers (repo default). Local vLLM is selected via the profile.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
