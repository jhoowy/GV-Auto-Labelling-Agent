# Copy to .env and fill in. Never commit .env.

# Storage
DATABASE_URL=postgresql+psycopg://vlabel:vlabel@localhost:5432/vlabel
BLOB_BACKEND=local            # local | minio
BLOB_LOCAL_DIR=./blobs
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minio
# MINIO_SECRET_KEY=minio123

# Active model profile (see config/profiles/*.yaml).
# `local` is the wired profile; `regular` is a proprietary template (not yet wired).
MODEL_PROFILE=local

# Proprietary provider keys — only used by the (unwired) `regular` template.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# google-genai key read by the labelling orchestrator (GeminiOrchestrator);
# required by the wired `local` profile's agent_llm.
GENAI_API_KEY=
